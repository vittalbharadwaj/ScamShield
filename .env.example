# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=your_token_factory_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Run `python list_models.py` to see exact IDs, then paste them here.
MODEL_FAST=PASTE_NEMOTRON_NANO_ID
MODEL_REASON=PASTE_NEMOTRON_SUPER_OR_ULTRA_ID

# --- Tavily (live web evidence) ---
TAVILY_API_KEY=your_tavily_key

# --- Abuse protection for the public demo ---
RATE_LIMIT_PER_10_MIN=12
